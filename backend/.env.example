SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development

# LLM_PROVIDER=fixture is the zero-cost default used for local dev, tests,
# and demos. Set LLM_PROVIDER=gemini and GEMINI_API_KEY to use real Gemini.
LLM_PROVIDER=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Same zero-cost-by-default pattern for research (Phase 3).
SEARCH_PROVIDER=fixture
TAVILY_API_KEY=
EXTRACTION_PROVIDER=fixture
FIRECRAWL_API_KEY=

# Real sending is disabled by default (Phase 4). Set EMAIL_MODE=sandbox to
# simulate sends with no credentials, or EMAIL_MODE=live + RESEND_API_KEY
# for real delivery via Resend.
EMAIL_MODE=disabled
RESEND_API_KEY=
