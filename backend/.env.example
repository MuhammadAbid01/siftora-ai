SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development

# LLM_PROVIDER=fixture is the zero-cost default used for local dev, tests,
# and demos. Set LLM_PROVIDER=openrouter and OPENROUTER_API_KEY to use real
# OpenRouter (default model is a free-tier model, so this stays zero-cost).
LLM_PROVIDER=fixture
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Free-tier models can take a couple of minutes under load.
OPENROUTER_TIMEOUT_SECONDS=180
# Chain-of-thought adds no accuracy to schema-bound extraction and cost ~6x
# latency on planning calls. Set to false only for a model that needs it.
OPENROUTER_DISABLE_REASONING=true

# Same zero-cost-by-default pattern for research (Phase 3).
SEARCH_PROVIDER=fixture
TAVILY_API_KEY=
EXTRACTION_PROVIDER=fixture
FIRECRAWL_API_KEY=

# Real sending is disabled by default (Phase 4). Set EMAIL_MODE=sandbox to
# simulate sends with no credentials, or EMAIL_MODE=live + RESEND_API_KEY
# for real delivery via Resend.
EMAIL_MODE=disabled
RESEND_API_KEY=
