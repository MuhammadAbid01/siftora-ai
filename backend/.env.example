SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development

# LLM_PROVIDER=fixture is the zero-cost default used for local dev, tests,
# and demos. Set LLM_PROVIDER=gemini and GEMINI_API_KEY to use real Gemini.
LLM_PROVIDER=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
